# Copy this file to .env for local development (never commit .env).
# In production, set these as environment variables in the Netlify dashboard —
# never in the frontend bundle or the repository.

# Transactional email (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Gadgets & Travels <orders@yourdomain.co.za>"

# Where contact/order/booking notifications are sent
BUSINESS_ORDERS_EMAIL=orders@yourdomain.co.za

# Spam protection (Cloudflare Turnstile or hCaptcha) — Phase 1 wiring point.
# Leave blank to run with honeypot + rate limiting only.
TURNSTILE_SECRET_KEY=

# Phase 2 — Yoco hosted checkout (not yet active)
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
